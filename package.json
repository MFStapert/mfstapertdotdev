{
  "name": "mfstapert",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/prune-sitemap.mjs",
    "watch": "vite build --watch",
    "test": "vitest run",
    "preview": "vite preview --outDir dist/analog/public",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.6",
    "@analogjs/router": "^2.9.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.2.1",
    "rxjs": "~7.8.0",
    "shiki": "^1.29.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.6",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "sass": "^1.108.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "oxfmt"
    ],
    "*.{html,json,jsonc,yml,yaml,md,scss,css}": "oxfmt"
  },
  "engines": {
    "node": ">=26"
  }
}

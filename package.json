{
  "name": "mfstapert.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "build": "vite build && node scripts/resume-pdf.mjs",
    "watch": "vite build --watch",
    "test": "vitest run",
    "preview": "vite preview --outDir dist/analog/public",
    "a11y": "pa11y-ci --sitemap http://localhost:4173/sitemap.xml --sitemap-find https://mfstapert.dev --sitemap-replace http://localhost:4173 --sitemap-exclude rss.xml",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.6",
    "@analogjs/router": "^2.9.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.2.1",
    "rxjs": "~7.8.0",
    "shiki": "^1.29.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.6",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "pa11y-ci": "^5.0.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "oxfmt"
    ],
    "*.{html,json,jsonc,yml,yaml,md,css}": "oxfmt"
  },
  "engines": {
    "node": ">=26"
  }
}
